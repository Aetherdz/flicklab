{
  "name": "flicklab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser aim trainer with seed-verifiable runs, bilingual AR/EN.",
  "scripts": {
    "dev": "node scripts/gen-pages.mjs && vite --host",
    "build": "node scripts/gen-pages.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fonts": "node scripts/fetch-fonts.mjs",
    "pages": "node scripts/gen-pages.mjs"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
